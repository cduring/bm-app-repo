{
  "expo": {
    "name": "Loam",
    "slug": "bm-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/loam-app-icon.png",
    "scheme": "bmapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.loamapp.loam",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Loam needs access to your photo library to upload profile photos, event covers, and portfolio images.",
        "NSLocationWhenInUseUsageDescription": "Loam uses your location to show you and other creators on the map.",
        "NSUserNotificationsUsageDescription": "Loam will send you event reminders and notify you when people RSVP to your events."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/loam-app-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.loamapp.loam",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/loam-favicon-32.png"
    },
    "plugins": [
      "expo-router",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsVersion": "11.16.2"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/loam-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/loam-icon.png",
          "color": "#FF5E1A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
